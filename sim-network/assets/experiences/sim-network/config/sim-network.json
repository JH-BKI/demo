        "type": "2d",
        "title": "01 - Splash",
        "description": "<p>Sim Network title splash.</p>",
        "customCss": "./assets/experiences/sim-network/styles/sim-network.css",
        "customScript": "./assets/experiences/sim-network/scripts/sim-network-splash.js",
        "typography": {
